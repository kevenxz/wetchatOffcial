# 微信公众号
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 搜索引擎
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=

# LLM
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=
# 结构化输出模型（原「快速模型」）。所有阶段都要求结构化 JSON 输出，
# 强烈建议此处配置一个**非推理模型**（如 deepseek-chat / qwen-plus / gpt-4o-mini）。
# 若留空则结构化阶段回退到 OPENAI_MODEL；当 OPENAI_MODEL 是推理模型时，
# 推理过程会耗尽 completion 预算导致 JSON 被截断，各阶段将退回模板文章。
OPENAI_FAST_MODEL=
OPENAI_FAST_API_KEY=
OPENAI_FAST_API_BASE=
# 结构化阶段使用哪个层：fast（默认，走 OPENAI_FAST_*）| strong（走 OPENAI_*）
LLM_STRUCTURED_TIER=fast
# 可选：把这些阶段钉在 strong 层（逗号分隔），其余结构化阶段仍走 fast
LLM_STRONG_STAGES=
# 结构化调用被截断时，按该倍数放大 token 预算重试一次；设为 1 表示不重试
LLM_TRUNCATION_RETRY_FACTOR=2
# 各阶段结构化输出的 token 上限（推理模型需要额外留出推理预算）
LLM_MAX_TOKENS_PLANNER=1200
LLM_MAX_TOKENS_BLUEPRINT=3000
LLM_MAX_TOKENS_STRATEGY=1200
LLM_MAX_TOKENS_DRAFT=4000
LLM_MAX_TOKENS_DRAFT_REVISION=2500
LLM_MAX_TOKENS_REVIEW=1200
# 视觉描述阶段（为每张图先写"画什么"）。该阶段必须走非推理模型，
# 否则同样会被截断并退化成不含文章信息的兜底画面。
LLM_MAX_TOKENS_VISUAL_SPEC=1200

# 可选：图片生成
DALLE_ENABLED=false
IMAGE_API_KEY=
IMAGE_API_BASE=
IMAGE_MODEL=
# 图片风格预设：editorial_photo（默认，编辑部摄影感）| concept_illustration | minimal_geometric
IMAGE_STYLE_PRESET=editorial_photo
# 是否允许画面出现文字。默认 false —— 图像模型渲染中文会变成乱码，
# 这也是此前"每张图都像海报、全是字"的直接原因。
IMAGE_ALLOW_TEXT=false
# 出图 prompt 字符上限（120–900）。prompt 越长，图像模型越容易丢掉主体、
# 转而把提示词里的文字画进画面。默认 400。
IMAGE_PROMPT_MAX_CHARS=400

# 生成链路性能调优（单机 2C2G 建议保持默认值）
# 研究阶段每个任务的并发查询数
RESEARCH_CONCURRENCY=4
# 每个任务的并发生图数；内存吃紧时降为 1
IMAGE_CONCURRENCY=2
# 进程级并发 LLM 调用上限
LLM_CONCURRENCY=3
# 单次 LLM 请求超时（秒）与重试次数
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
# 研究规划模式：rules（默认，不调用 LLM）| auto（仅模糊/高敏主题调用）| llm
PLANNER_MODE=rules
# 单进程同时执行的工作流数量上限；超出则排队
WORKFLOW_MAX_CONCURRENCY=2

# 搜索结果缓存（Redis）
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=21600

# 来源过滤（自动检索/抓取到的文章在进入证据包之前必须通过这些关卡）
# 正文最短字符数；低于该值视为导航页或抓取失败
SOURCE_MIN_CHARS=400
# 官方公告/文档类来源的较短下限：公告可能很短但仍是权威证据
SOURCE_OFFICIAL_MIN_CHARS=150
# 最少句子数，用于剔除明显的模板页/列表页
SOURCE_MIN_SENTENCES=3
# 主题词重合率下限（0~1）；低于该值判定为跑题
SOURCE_MIN_RELEVANCE=0.12
# 正文前 600 字的 shingle 相似度阈值；超过则视为同一通稿的转载
SOURCE_NEAR_DUP_SIMILARITY=0.85
# 单域名最多保留的条数，用于强制来源多样性
SOURCE_MAX_PER_DOMAIN=2
# 过滤后可用来源低于该数量时：继续生成，但强制人工复核
SOURCE_MIN_SURVIVORS=3

# 热点原文优先：先抓取热点对应的原始文章，用它决定文章结构
HOTSPOT_SOURCE_ENABLED=true

# Redis（token 缓存与搜索缓存；未配置时自动降级）
REDIS_URL=

# 数据库（PostgreSQL）。留空则使用 data/*.json 文件存储。
# 示例：postgresql://wechat:password@127.0.0.1:5432/wechat
# 首次连接且库为空时，会自动导入 data/*.json 并重命名为 *.imported 作为备份。
DATABASE_URL=

# 定时任务时区（cron 表达式的默认解释时区）
SCHEDULER_TIMEZONE=Asia/Shanghai

# 日志轮转（单机部署必须限制日志体积）
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
# 日志级别：DEBUG | INFO | WARNING | ERROR。排查问题时改成 DEBUG，无需改代码。
LOG_LEVEL=INFO
# 日志目录。测试会把它指向临时目录，避免污染生产日志。
LOG_DIR=logs
# 日志格式：留空 = 文件用 JSON、控制台用可读文本（默认）；
# 也可显式设为 json（两侧都 JSON）或 text（两侧都可读）。
LOG_FORMAT=
# 第三方库（httpx/httpcore/openai/langchain 等）固定不低于 WARNING，
# 否则 httpx 会为每个请求写一行 INFO，实测占全部日志行的 16%。
# 该项无需配置，此处仅作说明。

# 模型请求/响应完整内容的落盘策略。
# 完整 prompt/响应不再写入 app.log（曾占其体积的 57%，单行最长 3 万字符），
# 而是写入独立的 logs/model.log，每行一个 JSON 对象。
MODEL_LOG_PAYLOADS=true
MODEL_LOG_MAX_BYTES=20971520
MODEL_LOG_BACKUP_COUNT=3
# 单次 payload 的字符上限。注意这是「整份 payload」的上限，不是每个字段各算一次。
MODEL_LOG_MAX_CHARS=12000

# ── 热点抓取 ─────────────────────────────────────────────────────────────────
# 热点数据源。newsnow 是 TrendRadar 自己使用的结构化多平台接口
# （每个平台一次 JSON 调用），比爬 TopHub HTML 稳：实测后者重试 429 次、
# 176 次 source_unavailable。16 个平台：今日头条/百度/微博/抖音/知乎/贴吧/
# 澎湃/凤凰/B站/IT之家/华尔街见闻/财联社/金十/雪球/FastBull/市场资讯。
# 可填自建 newsnow 实例地址。
NEWSNOW_API_BASE=https://newsnow.busiyi.world/api

# 后台定时拉取周期（分钟）。默认 60；设为 1440 即为「每日一次」。
# 注意：热点衰减很快，20 小时前的热点拿来做今天的文章会明显掉队，
# TrendRadar 自己也是每小时抓一次（成本仅 16 次 GET）。
HOTSPOT_REFRESH_INTERVAL_MINUTES=60
# 快照超过该分钟数即视为过期，任务创建时会改为同步实时抓取。
HOTSPOT_SNAPSHOT_MAX_AGE_MINUTES=180
# 定时刷新使用哪个来源，以及只刷新哪些平台（留空 = 全部 16 个 newsnow 平台）。
HOTSPOT_REFRESH_SOURCE=newsnow
HOTSPOT_REFRESH_PLATFORMS=
# 每个平台每次抓取条数上限。
HOTSPOT_REFRESH_TOP_N=15
# 刷新失败（0 条）后的重试间隔。刷新「失败但时间戳是新的」不再占满整个周期：
# 曾出现 16 个平台同时失败，而下次尝试要等 60 分钟。
HOTSPOT_RETRY_INTERVAL_MINUTES=5

# ── 参考文章真实照片 ─────────────────────────────────────────────────────────
# 抓取「已被文章引用」的来源页面里的真实照片，用于封面与正文插图。
# 真实照片天然与内容匹配，且不消耗图像模型调用。
# 注意：使用第三方照片存在版权风险，因此**只要有照片被使用就强制人工审核**；
# 无法追溯出处的图片直接丢弃（不留痕就不用）。
SOURCE_IMAGE_ENABLED=true
# 每篇文章最多采用几张来源照片（封面占 1 张）。
SOURCE_IMAGE_MAX=3
# 真实像素下限（不是标签上声明的尺寸——那通常缺失，正是过去漏掉 logo/小图的原因）。
SOURCE_IMAGE_MIN_WIDTH=600
SOURCE_IMAGE_MIN_HEIGHT=300
# 单张下载体积上限（字节），默认 8 MB。
SOURCE_IMAGE_MAX_BYTES=8388608
# 只允许这些域名（逗号分隔，留空 = 不限制）。需要收紧版权风险时使用。
SOURCE_IMAGE_ALLOWED_DOMAINS=
# 是否在图片下方显示「图片来源：xxx」。默认关闭（只在元数据与审核中体现）；
# 设为 true 即在正文里可见署名。
SOURCE_IMAGE_CREDIT=false
# 封面是否优先使用来源照片（需裁剪到微信 2.35:1）。
COVER_SOURCE_PREFERRED=true
# 封面裁切丢弃超过该比例时在审核中提示（本系统无视觉模型，无法判断主体是否被裁掉）。
COVER_CROP_DISCARD_WARN=0.25

# 失败告警（可选，默认关闭）。支持企业微信机器人等 JSON webhook。
ALERT_WEBHOOK=
# 预留：邮件告警收件人
ALERT_EMAIL=

# 服务
API_HOST=0.0.0.0
API_PORT=8001
