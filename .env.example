# 微信公众号
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 搜索引擎
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=

# LLM
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=
# 可选：规划与评审阶段使用的快速模型。留空则全部阶段使用 OPENAI_MODEL。
OPENAI_FAST_MODEL=
OPENAI_FAST_API_KEY=
OPENAI_FAST_API_BASE=

# 可选：图片生成
DALLE_ENABLED=false
IMAGE_API_KEY=
IMAGE_API_BASE=
IMAGE_MODEL=

# 生成链路性能调优（单机 2C2G 建议保持默认值）
# 研究阶段每个任务的并发查询数
RESEARCH_CONCURRENCY=4
# 每个任务的并发生图数；内存吃紧时降为 1
IMAGE_CONCURRENCY=2
# 进程级并发 LLM 调用上限
LLM_CONCURRENCY=3
# 单次 LLM 请求超时（秒）与重试次数
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
# 研究规划模式：rules（默认，不调用 LLM）| auto（仅模糊/高敏主题调用）| llm
PLANNER_MODE=rules

# 搜索结果缓存（Redis）
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=21600

# Redis（token 缓存与搜索缓存；未配置时自动降级）
REDIS_URL=

# 服务
API_HOST=0.0.0.0
API_PORT=8001
